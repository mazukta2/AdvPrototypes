  TurnOnDecriptionText: "\t\u0421\u0442\u0430\u0440\u044B\u0439 \u0434\u0432\u043E\u0440\u0444\u0441\u043A\u0438\u0439
    \u043C\u0430\u044F\u043A \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u043F\u0443\u0442\u044C
    \u0432 \u043F\u0435\u0449\u0435\u0440\u0430\u0445 \u043F\u043E\u043D\u0438\u0436\u0430\u044F
    \u0438\u0445 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C. "
  TurnOffDecriptionText: "\t\u0421\u0442\u0430\u0440\u044B\u0439 \u0434\u0432\u043E\u0440\u0444\u0441\u043A\u0438\u0439
    \u043C\u0430\u044F\u043A \u0441\u0435\u0439\u0447\u0430\u0441 \u0431\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442.
    \u041F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u0443\u0441\u0438\u043B\u0438\u044F
    \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C."
  DestroyedDescriptionText: "\t\u041C\u0430\u044F\u043A \u0441\u043B\u043E\u043C\u0430\u043D.
    \u041A\u0440\u0438\u0441\u0442\u0430\u043B \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u0439
    \u0441\u0432\u0435\u0442, \u0431\u044B\u043B \u0432\u044B\u0442\u0430\u0449\u0435\u043D
    \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E."
