  m_text: "\t\u0421\u0442\u0430\u0440\u0430\u044F \u0437\u0430\u0441\u0442\u0430\u0432\u0430
    \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442 \u043F\u0443\u0442\u044C
    \u0432\u043F\u0435\u0440\u0435\u0434. \u0412\u043E\u0440\u043E\u0442\u0430 \u0434\u0430\u0432\u043D\u043E
    \u0441\u043B\u043E\u043C\u0430\u043D\u044B \u043D\u043E \u0441\u0442\u0430\u044F
    \u043A\u043E\u0431\u043E\u043B\u044C\u0434\u043E\u0432 \u0441\u043E\u043E\u0440\u0443\u0434\u0438\u043B\u0430
    \u0438\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0443\u044E
    \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u0438\u0437 \u043F\u043E\u0442\u0440\u0435\u043F\u0430\u043D\u043D\u044B\u0445
    \u0449\u0438\u0442\u043E\u0432. \u0417\u0430\u0432\u0438\u0434\u0438\u0432 \u0432\u0430\u0441
    \u043E\u043D\u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442 \u043A\u043E\u043F\u044C\u044F,
    \u0442\u0440\u0435\u0431\u0443\u044F \u043E\u043F\u043B\u0430\u0442\u044B \u0437\u0430
    \u043F\u0440\u043E\u0445\u043E\u0434."
